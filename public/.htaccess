# Grow Money — SPA em subpasta /grow
# Coloque este arquivo junto com index.html dentro de public_html/grow/

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /grow/

  # Arquivos e pastas reais (assets, etc.) passam direto
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Demais rotas do React → index.html
  RewriteRule . /grow/index.html [L]
</IfModule>

# Cache de assets estáticos
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

